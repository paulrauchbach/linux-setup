#!/usr/bin/env bash

set -euo pipefail

: "${HOME:?HOME is not set. Please run as a regular user.}"

die() {
	printf 'linux-setup: %s\n' "$*" >&2
	exit 1
}

INSTALL_DIR="${LINUX_SETUP_INSTALL_DIR:-$HOME/.local/share/linux-setup}"
REPO_REF="${LINUX_SETUP_REPO_REF:-main}"
LINUX_SETUP_LAUNCHER_API=1

[ -d "$INSTALL_DIR/.git" ] ||
	die "$INSTALL_DIR is not a Git checkout. Run install.sh to install or repair linux-setup."

if ! git -C "$INSTALL_DIR" diff --quiet ||
	! git -C "$INSTALL_DIR" diff --cached --quiet; then
	die "$INSTALL_DIR has local changes. Commit or discard them before updating."
fi

printf '\nLinux Setup\n\n'

local_commit="$(git -C "$INSTALL_DIR" rev-parse HEAD)"
printf '==> Checking for linux-setup updates\n'

git -C "$INSTALL_DIR" fetch --quiet --depth=1 origin "$REPO_REF"

remote_commit="$(git -C "$INSTALL_DIR" rev-parse FETCH_HEAD^{commit})"

if [ "$local_commit" != "$remote_commit" ]; then
	printf '==> Updating linux-setup\n'

	# This is a managed installation, not a development checkout. Keep it on the
	# exact requested remote snapshot so updates do not depend on shallow branch
	# ancestry (which disappears as soon as the remote advances more than once).
	git -C "$INSTALL_DIR" checkout --quiet --detach -f FETCH_HEAD

	# Keep the command itself in sync with the checkout it updates. The API marker
	# prevents this repaired launcher from downgrading itself while the remote still
	# contains the branch-merging implementation that it is replacing.
	if grep -q '^LINUX_SETUP_LAUNCHER_API=1$' "$INSTALL_DIR/linux-setup"; then
		mkdir -p "$HOME/.local/bin"
		install -m 0755 "$INSTALL_DIR/linux-setup" "$HOME/.local/bin/linux-setup"
	fi
fi

exec env LINUX_SETUP_INSTALL_DIR="$INSTALL_DIR" bash "$INSTALL_DIR/setup.sh" "$@"
