[Desktop Entry]
Type=Application
Name=T3 Code
Exec=/home/paul/.local/bin/t3-code %U
TryExec=/home/paul/.local/bin/t3-code
Icon=/home/paul/Applications/t3-code-icon.png
Terminal=false
Categories=Utility;
# Must match the window's WM_CLASS, or GNOME cannot tie the window to this
# entry and alt-tab falls back to a generic icon. Electron derives WM_CLASS
# from app.setName(), which T3 Code sets to its display name ("T3 Code
# (Alpha)"), not from the t3code executable name. Upstream's packaged entry
# hardcodes StartupWMClass=t3code and is wrong for the same reason.
# Nightly builds label themselves "T3 Code (Nightly)" and would need this
# value changed to match.
StartupWMClass=T3 Code (Alpha)
