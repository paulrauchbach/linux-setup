#!/usr/bin/env bash
set -euo pipefail

unset APPDIR APPIMAGE ARGV0 ELECTRON_RUN_AS_NODE

appimage="${T3_CODE_APPIMAGE:-$HOME/Applications/T3-Code-x86_64.AppImage}"

if [ ! -x "$appimage" ]; then
	printf 't3-code: AppImage not found or not executable: %s\n' "$appimage" >&2
	printf 't3-code: run configs/manual/setup-t3-code to build and install it.\n' >&2
	exit 1
fi

exec /usr/bin/zsh -lic 'exec "$@"' t3-code "$appimage" "$@"

