#!/usr/bin/env bash
set -euo pipefail

: "${HOME:?HOME is not set. Run this as your regular user.}"

MANUAL_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
T3_CODE_REPO="${T3_CODE_REPO:-$HOME/dev/t3code}"
APPLICATIONS_DIR="${APPLICATIONS_DIR:-$HOME/Applications}"
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"
DESKTOP_DIR="${DESKTOP_DIR:-$HOME/.local/share/applications}"
APPIMAGE_LINK="${T3_CODE_APPIMAGE:-$APPLICATIONS_DIR/T3-Code-x86_64.AppImage}"
ICON_TARGET="${T3_CODE_ICON:-$APPLICATIONS_DIR/t3-code-icon.png}"
BUILD_APP="${BUILD_APP:-yes}"
INSTALL_DEPS="${INSTALL_DEPS:-yes}"

usage() {
	cat <<'EOF'
Usage: setup-t3-code [options]

Build T3 Code from ~/dev/t3code, install the AppImage, and refresh the
user-local t3-code wrapper and desktop entry.

Options:
  --no-build       Reinstall wrapper, icon, and desktop entry without rebuilding
  --no-install     Skip pnpm install before building
  -h, --help       Show this help

Environment:
  T3_CODE_REPO     T3 Code checkout path (default: ~/dev/t3code)
  T3_CODE_APPIMAGE Stable AppImage link path (default: ~/Applications/T3-Code-x86_64.AppImage)
  APPLICATIONS_DIR AppImage/icon install directory (default: ~/Applications)
EOF
}

log_step() {
	printf '\n==> %s\n' "$*"
}

die() {
	printf 'setup-t3-code: %s\n' "$*" >&2
	exit 1
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		--no-build)
			BUILD_APP="no"
			;;
		--no-install)
			INSTALL_DEPS="no"
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			die "Unknown option '$1'."
			;;
	esac
	shift
done

[ "$EUID" -ne 0 ] || die "Do not run this script as root."
[ -d "$T3_CODE_REPO/.git" ] || die "T3_CODE_REPO is not a git checkout: $T3_CODE_REPO"
[ -f "$MANUAL_DIR/t3-code" ] || die "Missing wrapper template: $MANUAL_DIR/t3-code"
[ -f "$MANUAL_DIR/t3-code.desktop" ] || die "Missing desktop template: $MANUAL_DIR/t3-code.desktop"

command -v pnpm >/dev/null 2>&1 || die "pnpm is required. Enable it with corepack or install pnpm first."

if [ "$BUILD_APP" = "yes" ] && ! command -v magick >/dev/null 2>&1 && ! command -v convert >/dev/null 2>&1; then
	die "ImageMagick is required for the Linux desktop build. Install it with: sudo apt-get install imagemagick"
fi

latest_appimage() {
	find "$T3_CODE_REPO/release" -type f -name 'T3-Code-*.AppImage' -printf '%T@ %p\n' 2>/dev/null |
		sort -nr |
		sed 's/^[^ ]* //' |
		head -n 1
}

if [ "$BUILD_APP" = "yes" ]; then
	log_step "Building T3 Code from $T3_CODE_REPO"
	cd "$T3_CODE_REPO"

	if [ "$INSTALL_DEPS" = "yes" ]; then
		pnpm install --frozen-lockfile
	fi

	pnpm run dist:desktop:linux
fi

built_appimage="$(latest_appimage)"
[ -n "$built_appimage" ] || die "No T3 Code AppImage found under $T3_CODE_REPO/release."
[ -f "$built_appimage" ] || die "Built AppImage does not exist: $built_appimage"

mkdir -p "$APPLICATIONS_DIR" "$BIN_DIR" "$DESKTOP_DIR"

versioned_appimage="$APPLICATIONS_DIR/$(basename "$built_appimage")"
log_step "Installing AppImage"
install -m 0755 "$built_appimage" "$versioned_appimage"
ln -sfn "$versioned_appimage" "$APPIMAGE_LINK"
printf 'Installed %s -> %s\n' "$APPIMAGE_LINK" "$versioned_appimage"

source_icon="$T3_CODE_REPO/apps/desktop/resources/icon.png"
if [ -f "$source_icon" ]; then
	log_step "Installing desktop icon"
	install -m 0644 "$source_icon" "$ICON_TARGET"
fi

log_step "Installing t3-code wrapper"
install -m 0755 "$MANUAL_DIR/t3-code" "$BIN_DIR/t3-code"

log_step "Installing desktop entry"
desktop_tmp="$(mktemp)"
sed "s|/home/paul|$HOME|g" "$MANUAL_DIR/t3-code.desktop" >"$desktop_tmp"
install -m 0644 "$desktop_tmp" "$DESKTOP_DIR/t3-code.desktop"
rm -f "$desktop_tmp"

if command -v update-desktop-database >/dev/null 2>&1; then
	update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true
fi

printf '\nT3 Code is ready.\n'
printf 'Wrapper: %s\n' "$BIN_DIR/t3-code"
printf 'Desktop entry: %s\n' "$DESKTOP_DIR/t3-code.desktop"
